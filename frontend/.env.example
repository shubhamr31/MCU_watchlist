VITE_API_BASE_URL=http://localhost:4000
VITE_GOOGLE_CLIENT_ID=your_google_oauth_web_client_id

# Guest mode (no sign-in): progress is stored in sessionStorage for the current tab/session only.
# Optional: Supabase email magic link (free tier). Create a project, run supabase/migrations/001_watchlist_progress.sql, then:
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key
